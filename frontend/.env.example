# Required FastAPI base URL, supplied at build time for each environment.
# Without this variable the application cannot connect to the API.
VITE_API_URL=https://safevision-backend-pw6t.onrender.com

# Optional MJPEG URL served by the IoT video process.
# Set this to an absolute HTTP(S) URL reachable from the browser running the frontend.
# Do not assume localhost: the IoT process may run on another computer.
VITE_VIDEO_URL=
